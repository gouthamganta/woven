<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WovenSourceRoot Condition="'$(WovenSourceRoot)' == ''">../.local/full-qa-baseline</WovenSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <ProjectReference Include="$(WovenSourceRoot)/backend/WovenBackend/WovenBackend.csproj" />
  </ItemGroup>
</Project>
