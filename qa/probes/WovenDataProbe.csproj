<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <WovenBackendProject Condition="'$(WovenBackendProject)' == ''">../../backend/WovenBackend/WovenBackend.csproj</WovenBackendProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <ProjectReference Include="$(WovenBackendProject)" />
  </ItemGroup>
</Project>
