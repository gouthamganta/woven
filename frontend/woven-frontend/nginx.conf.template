worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # --------------------
    # Query-safe access logging
    # Query strings can carry credentials (SignalR WebSocket access_token, OAuth
    # callback code/state, SAS signatures), so neither the request line nor the
    # referrer is logged with its query. $request_uri is used (not $uri) so the
    # original path is logged even after the SPA document rewrite.
    # --------------------
    map $request_uri $woven_log_path {
        default                         "-";
        "~^(?<woven_log_path_match>[^?]*)" $woven_log_path_match;
    }

    map $http_referer $woven_log_referer {
        default                            "-";
        "~^(?<woven_log_referer_match>[^?#]*)" $woven_log_referer_match;
    }

    log_format main '$remote_addr - $remote_user [$time_local] '
                    '"$request_method $woven_log_path $server_protocol" '
                    '$status $body_bytes_sent "$woven_log_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # --------------------
    # Gzip compression
    # --------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/xml
        application/xml+rss
        text/javascript
        image/svg+xml;

    # --------------------
    # Browser document navigation detection
    # A GET/HEAD whose Accept header includes text/html is a page load (address bar,
    # refresh, deep link) and must get the Angular shell. Angular HttpClient sends
    # Accept: application/json, text/plain, */* and SignalR never asks for text/html,
    # so API calls (and every POST/PUT/DELETE) fall through to the backend proxy.
    # --------------------
    map "$request_method:$http_accept" $woven_spa_document {
        default                  0;
        "~*^(GET|HEAD):.*text/html" 1;
    }

    # WebSocket upgrade support for the SignalR hub
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 80;
        server_name _;

        # DNS resolver for Container Apps internal DNS
        resolver 168.63.129.16 valid=30s;

        # --------------------
        # Angular app root
        # --------------------
        root /usr/share/nginx/html;
        index index.csr.html;

        # --------------------
        # Security headers
        # nginx add_header is only inherited by locations that define no add_header
        # of their own, so any location below that adds a header must repeat these.
        # --------------------
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # --------------------
        # Health check (frontend-level)
        # --------------------
        location = /health {
            return 200 'healthy';
            add_header Content-Type text/plain;
        }

        # --------------------
        # Backend API proxy
        # BACKEND_URL and BACKEND_HOST are replaced at container startup via envsubst.
        # Docker Compose: BACKEND_URL=http://backend:8080, BACKEND_HOST=backend:8080
        # Container Apps: BACKEND_URL=https://<fqdn>, BACKEND_HOST=<fqdn>
        #
        # Azure Container Apps routes by Host header, so we MUST send the backend
        # FQDN as Host (not $host which is the frontend domain). We also need
        # proxy_ssl_verify off + proxy_ssl_server_name on for internal HTTPS.
        # --------------------

        location = /signin-google {
            proxy_pass ${BACKEND_URL}/signin-google;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_ssl_name ${BACKEND_HOST};
            proxy_http_version 1.1;
            proxy_set_header Host ${BACKEND_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/ {
            proxy_pass ${BACKEND_URL}/api/;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_ssl_name ${BACKEND_HOST};
            proxy_http_version 1.1;
            proxy_set_header Host ${BACKEND_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /auth/google {
            proxy_pass ${BACKEND_URL}/auth/google;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_ssl_name ${BACKEND_HOST};
            proxy_http_version 1.1;
            proxy_set_header Host ${BACKEND_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location ^~ /auth/ {
            proxy_pass ${BACKEND_URL}/auth/;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_ssl_name ${BACKEND_HOST};
            proxy_http_version 1.1;
            proxy_set_header Host ${BACKEND_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # SignalR hub (Program.cs MapHub "/hubs/woven"): negotiate POST, WebSocket
        # upgrade, SSE and long-polling all go straight to the backend. Never SPA.
        location ^~ /hubs/ {
            proxy_pass ${BACKEND_URL}/hubs/;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_ssl_name ${BACKEND_HOST};
            proxy_http_version 1.1;
            proxy_set_header Host ${BACKEND_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
        }

        # Public legal metadata (LegalEndpoints.cs). No SPA route lives under
        # /legal/ (the pages are /privacy, /terms, /data-policy), so always proxy.
        location ^~ /legal/ {
            proxy_pass ${BACKEND_URL}/legal/;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_ssl_name ${BACKEND_HOST};
            proxy_http_version 1.1;
            proxy_set_header Host ${BACKEND_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # --------------------
        # Backend API groups served at the root (no /api prefix) — see Program.cs
        # and Endpoints/*.cs MapGroup/Map* prefixes. Several share paths with SPA
        # routes (/moments, /commons, /chats, /chats/:id, /matches/:id/profile,
        # /onboarding/*), so browser document GETs are internally rewritten to the
        # Angular shell; everything else (JSON GETs, POST/PUT/DELETE) is proxied.
        # Must stay ABOVE the static-asset regex so e.g. DELETE /media/.../x.jpg
        # is proxied rather than served as a static file.
        # Dev-only groups (/dev, /debug) are intentionally not exposed here.
        # --------------------
        location ~ ^/(admin|chats|coaching|commons|games|intake|matches|me|media|moments|onboarding|orbit|push-notifications|seasons|sparks|support|tiles|verification)(/|$) {
            if ($woven_spa_document) {
                rewrite ^ /index.csr.html last;
            }
            proxy_pass ${BACKEND_URL};
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_ssl_name ${BACKEND_HOST};
            proxy_http_version 1.1;
            proxy_set_header Host ${BACKEND_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # --------------------
        # Cache static assets
        # --------------------
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-XSS-Protection "1; mode=block" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        }

        # --------------------
        # Do not cache the app shell
        # --------------------
        location = /index.csr.html {
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate";
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-XSS-Protection "1; mode=block" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        }

        # --------------------
        # Angular SPA routing (must be LAST)
        # --------------------
        location / {
            try_files $uri $uri/ /index.csr.html;
        }
    }
}
